---
import Base from '../layouts/Base.astro';
import { getCaptionedImages } from '../utils/imageCaptions.js';

export const prerender = true;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const slides = await getCaptionedImages();
const slidesJson = JSON.stringify(slides).replace(/</g, '\\u003c');
const first = slides[0];
---
<Base>
  <!-- UNDER CONSTRUCTION -->
  <div class="under-construction">
    <span class="construction-icon">&#9881;</span>
    <span class="construction-blink">&#9724;</span>
    &nbsp; FREE PALESTINE &nbsp;
    <span class="construction-blink">&#9724;</span>
    <span class="construction-icon">&#9881;</span>
  </div>
  
  <!-- ACCENT BAR -->
  <div class="accent-bar">
    <span class="accent-star as-l1">&#10022;</span>
    <span class="accent-star as-l2">&#10022;</span>
    <span class="accent-star as-l3">&#10022;</span>
    <span class="accent-star as-l4">&#10022;</span>
    <span class="accent-star as-l5">&#10022;</span>
    <span class="accent-star as-l6">&#10022;</span>
    <div class="accent-line"></div>
    <div class="planet-accent">
      <div class="orbit"><div class="planet"></div><div class="sun"></div></div>
    </div>
    <div class="accent-line"></div>
    <span class="accent-star as-r1">&#10022;</span>
    <span class="accent-star as-r2">&#10022;</span>
    <span class="accent-star as-r3">&#10022;</span>
    <span class="accent-star as-r4">&#10022;</span>
    <span class="accent-star as-r5">&#10022;</span>
    <span class="accent-star as-r6">&#10022;</span>
  </div>
  <div class="info-block">
    <p>Welcome, friends, family, well-wishers, and nay-sayers! Check out the navigation links on the menu to your left.
    </p>
  </div>
  {first && (
    <section class="carousel" id="carousel" aria-label="Random photos from this site">
      <div class="card-titlebar">
        <div class="titlebar-icon">&#128247;</div>
        <div class="card-titlebar-text">// RANDOM FROM THE ARCHIVE //</div>
      </div>
      <div class="carousel-stage">
        <button type="button" class="car-btn" id="car-prev" aria-label="Previous photo">&#9668;</button>
        <img id="car-img" class="car-img" src={first.src} alt={first.caption} />
        <button type="button" class="car-btn" id="car-next" aria-label="Next photo">&#9658;</button>
      </div>
      <div class="carousel-meta">
        <div class="car-caption" id="car-caption">{first.caption}</div>
        <a class="car-post" id="car-post" href={first.href}>FROM: {first.post} &#9658;</a>
        <div class="car-count" id="car-count"></div>
      </div>
    </section>
    <script type="application/json" id="carousel-data" set:html={slidesJson}></script>
  )}
  <div class="counter-wrap">
    <div class="counter-label">// YOU ARE ACTUALLY VISITOR NUMBER</div>
    <div class="hit-counter" id="site-counter">
      <span class="hit-digit">0</span>
      <span class="hit-digit">0</span>
      <span class="hit-digit">0</span>
      <span class="hit-digit">0</span>
      <span class="hit-digit">0</span>
      <span class="hit-digit">0</span>
    </div>
  </div>
  
</Base>

<style>
  /* UNDER CONSTRUCTION */
  .under-construction {
    display: flex;
    align-items: center;
    gap: 14px;
    background: repeating-linear-gradient(
      45deg, #1a0000, #1a0000 12px, #2a0800 12px, #2a0800 24px
    );
    border: 2px solid var(--red);
    box-shadow: 0 0 12px rgba(255,68,68,0.3), inset 1px 1px 0 rgba(255,255,255,0.05);
    padding: 10px 16px;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--red);
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .construction-icon {
    font-size: 1.4rem;
    animation: spin-slow 3s linear infinite;
    display: inline-block;
  }
  @keyframes spin-slow {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .construction-blink { animation: blink 0.9s step-end infinite; }
  @keyframes blink {
    0%,100% { opacity: 1; }
    50%      { opacity: 0; }
  }

  /* ACCENT BAR */
  .accent-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
    align-items: center;
  }
  .accent-star { font-size: 1rem; animation: twinkle 1.4s ease-in-out infinite; }
  .as-l1 { color: #ff2020; animation-delay: 0.0s; }
  .as-l2 { color: #ff8800; animation-delay: 0.2s; }
  .as-l3 { color: #ffd84d; animation-delay: 0.4s; }
  .as-l4 { color: #39ff14; animation-delay: 0.6s; }
  .as-l5 { color: #00eaff; animation-delay: 0.8s; }
  .as-l6 { color: #cc44ff; animation-delay: 1.0s; }
  .as-r1 { color: #cc44ff; animation-delay: 1.0s; }
  .as-r2 { color: #00eaff; animation-delay: 0.8s; }
  .as-r3 { color: #39ff14; animation-delay: 0.6s; }
  .as-r4 { color: #ffd84d; animation-delay: 0.4s; }
  .as-r5 { color: #ff8800; animation-delay: 0.2s; }
  .as-r6 { color: #ff2020; animation-delay: 0.0s; }
  @keyframes twinkle {
    0%,100% { opacity: 1;   transform: scale(1);   }
    50%      { opacity: 0.2; transform: scale(0.6); }
  }
  @keyframes twinkle-inv {
    0%,100% { opacity: 0.2; transform: scale(0.6); }
    50%      { opacity: 1;   transform: scale(1);   }
  }
  .accent-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--panel-border), transparent);
  }
  .planet-accent {
    display: flex;
    justify-content: center;
    margin: 10px 0 20px;
    height: 60px;
    position: relative;
  }
  .orbit {
    width: 60px; height: 60px;
    border: 1px dashed rgba(0,180,255,0.3);
    border-radius: 50%;
    position: relative;
    animation: orbit-spin 6s linear infinite;
  }
  .planet {
    position: absolute;
    top: -5px; left: 50%;
    transform: translateX(-50%);
    width: 10px; height: 10px;
    background: radial-gradient(circle at 35% 35%, #7af, #025);
    border-radius: 50%;
    box-shadow: 0 0 6px #0af;
  }
  .sun {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 18px; height: 18px;
    background: radial-gradient(circle at 40% 40%, #ffe080, #e05000);
    border-radius: 50%;
    box-shadow: 0 0 14px rgba(255,160,40,0.7);
  }
  @keyframes orbit-spin {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* CAROUSEL */
  .carousel {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    box-shadow:
      inset 1px 1px 0 rgba(255,255,255,0.09),
      inset -1px -1px 0 rgba(0,0,0,0.6),
      0 8px 40px rgba(0,0,0,0.7),
      0 0 20px rgba(0,100,200,0.1);
    margin-bottom: 22px;
    overflow: hidden;
  }
  .card-titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, #001848 0%, #00091f 100%);
    padding: 7px 12px;
    border-bottom: 1px solid var(--panel-border);
  }
  .titlebar-icon { font-size: 1rem; }
  .card-titlebar-text {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--dim);
    text-transform: uppercase;
    flex: 1;
    text-align: center;
  }
	.carousel-stage {
    display: flex;
    align-items: stretch;
    background: #000;
  }
	.car-img {
    flex: 1;               /* Takes up remaining available width */
    min-width: 0;          /* Allows image flex child to shrink properly */
    width: 100%;
    height: min(60vh, 480px);
    object-fit: contain;
    display: block;
  }
  .car-btn {
    flex: 0 0 38px;
    background: #00091f;
    color: var(--cyan);
    border: none;
    border-left: 1px solid var(--panel-border);
    border-right: 1px solid var(--panel-border);
    font-size: 1rem;
    cursor: pointer;
  }
  .car-btn:hover, .car-btn:focus-visible { background: #001848; color: var(--gold); }
  .carousel-meta {
    padding: 12px 20px 14px;
    text-align: center;
    border-top: 1px solid var(--panel-border);
  }
  .car-caption {
    color: var(--gold);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  .car-post {
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .car-count {
    margin-top: 6px;
    font-size: 0.62rem;
    color: var(--dim);
    letter-spacing: 0.2em;
  }
  
  .counter-wrap {
    text-align: center;
    padding: 20px;
    margin-top: 10px;
    border-top: 1px solid var(--panel-border);
  }
  .counter-label {
    font-size: 0.65rem;
    color: var(--dim);
    letter-spacing: 0.25em;
    margin-bottom: 8px;
  }
  
  .card-titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(90deg, #001848 0%, #00091f 100%);
    padding: 10px 14px; /* Increased padding slightly */
    border-bottom: 1px solid var(--panel-border);
  }
  .titlebar-icon { font-size: 1.2rem; }
  .card-titlebar-text {
    font-size: 0.85rem;       /* Increased from 0.68rem */
    font-weight: 700;         /* Added bolding */
    letter-spacing: 0.2em;
    color: var(--cyan);       /* Changed from var(--dim) to make it pop more, or keep var(--dim) */
    text-transform: uppercase;
    flex: 1;
    text-align: center;
  }
</style>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  // ---- SITE COUNTER ----
  async function loadAndIncrementCounter() {
    try {
      const res = await fetch(
        `${supabaseUrl}/rest/v1/rpc/increment_counter`,
        {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json'
          },
          body: '{}'
        }
      );
      if (!res.ok) throw new Error(`Counter API error ${res.status}`);
      const current = await res.json();

      const digits = String(current).padStart(6, '0').split('');
      const container = document.getElementById('site-counter');
      if (container) {
        container.innerHTML = digits.map(d => `<span class="hit-digit">${d}</span>`).join('');
      }
    } catch (e) {
      console.error("Counter failed:", e);
    }
  }
   // ---- INIT ----
  const PROD = ['gaysex.solutions', 'www.gaysex.solutions'];
  if (PROD.includes(location.hostname)) loadAndIncrementCounter();
</script>

<script>
  // Random-order carousel built from #carousel-data (generated at build time).
  const dataEl = document.getElementById('carousel-data');
  if (dataEl) {
    const all = JSON.parse(dataEl.textContent || '[]');
    const MAX_SLIDES = 30;
    const INTERVAL_MS = 6282;

    // Fisher-Yates shuffle, keep a subset
    for (let i = all.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [all[i], all[j]] = [all[j], all[i]];
    }
    const slides = all.slice(0, MAX_SLIDES);

    const img = document.getElementById('car-img');
    const cap = document.getElementById('car-caption');
    const post = document.getElementById('car-post');
    const count = document.getElementById('car-count');
    const root = document.getElementById('carousel');
    let idx = 0;
    let timer = null;

    function show(i) {
      idx = (i + slides.length) % slides.length;
      const s = slides[idx];
      img.src = s.src;
      img.alt = s.caption;
      cap.textContent = s.caption;
      post.textContent = 'FROM: ' + s.post + ' \u25BA';
      post.href = s.href;
      count.textContent = (idx + 1) + ' / ' + slides.length;
      new Image().src = slides[(idx + 1) % slides.length].src; // preload next
    }
    function start() {
      if (timer || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => show(idx + 1), INTERVAL_MS);
    }
    function stop() { clearInterval(timer); timer = null; }

    document.getElementById('car-prev').addEventListener('click', () => show(idx - 1));
    document.getElementById('car-next').addEventListener('click', () => show(idx + 1));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    show(0);
    start();
  }
</script>
