<style>
  h1 {
    font-size: 1.3rem;
    color: var(--white);
    letter-spacing: 0.08em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  h2 {
    font-size: 1.2rem;
    color: var(--cyan);
    letter-spacing: 0.08em;
    margin-top: 8px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  h3 {
    font-size: 1.1rem;
    color: var(--gold);
    letter-spacing: 0.08em;
    margin-top: 12px;
    margin-bottom: 8px;
  }

/* Big custom horizontal line */
  .content-divider {
    display: block;
    border: none;
    height: 4px; /* Thickness of the line */
    background-color: var(--cyan); /* Uses your site's cyan theme color */
    width: 100%;
    margin: 24px 0;
  }

  .img-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
  }

  .img-item {
    height: 220px; /* Fixed row height */
    flex: 1 1 250px;
  }

  .img-item img {
    width: wrap;
    height: 100%;
    object-fit: fill; /* Stretches/fits images as requested */
  }
</style>